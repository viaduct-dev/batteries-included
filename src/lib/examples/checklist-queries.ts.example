// Optional checklist queries. Copy into src/lib/graphql.ts after enabling the backend example.
// Create/update now return the pg-persistence payload's checklistItem field.
export const GET_CHECKLIST_ITEMS = `
  query { checklistItems { id title completed groupId userId createdAt updatedAt } }
`;

export const GET_CHECKLIST_ITEMS_BY_GROUP = `
  query ItemsByGroup($groupId: ID!) {
    group(id: $groupId) { checklistItems { id title completed groupId } }
  }
`;

export const CREATE_CHECKLIST_ITEM = `
  mutation CreateItem($title: String!, $groupId: ID!) {
    createChecklistItem(input: {title: $title, groupId: $groupId}) {
      checklistItem { id title completed groupId userId createdAt updatedAt }
    }
  }
`;

export const UPDATE_CHECKLIST_ITEM = `
  mutation UpdateItem($id: ID!, $completed: Boolean, $title: String) {
    updateChecklistItem(input: {id: $id, completed: $completed, title: $title}) {
      checklistItem { id title completed groupId }
    }
  }
`;

export const DELETE_CHECKLIST_ITEM = `
  mutation DeleteItem($id: ID!) {
    deleteChecklistItem(input: {id: $id}) { userErrors { message } }
  }
`;
